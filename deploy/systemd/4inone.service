# Django (gunicorn) als Dienst: startet nach einem Neustart von selbst und nach einem Absturz neu.
# Nach /etc/systemd/system/4inone.service kopieren, dann:
#   sudo systemctl daemon-reload && sudo systemctl enable --now 4inone
# Die Einstellungen liest Django selbst aus backend/.env (config/settings.py › read_env) — kein EnvironmentFile nötig.
[Unit]
Description=4inOne Django (gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/4inone/backend
# Nur auf 127.0.0.1: erreichbar ausschließlich über nginx, nie direkt aus dem Netz
ExecStart=/srv/4inone/backend/.venv/bin/gunicorn config.wsgi:application --workers 3 --timeout 30 --bind 127.0.0.1:8000
Restart=always
RestartSec=3

# Härtung: der Dienst darf nur in seine eigenen Ordner schreiben
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/4inone-data

[Install]
WantedBy=multi-user.target
