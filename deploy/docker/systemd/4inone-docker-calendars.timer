# Lumiknot (Docker): Kalender-Abos aktualisieren. Aktivieren: sudo systemctl enable --now 4inone-docker-calendars.timer
[Unit]
Description=Lumiknot (Docker): Kalender-Abos aktualisieren

[Timer]
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true
Unit=4inone-docker@calendars.service

[Install]
WantedBy=timers.target
