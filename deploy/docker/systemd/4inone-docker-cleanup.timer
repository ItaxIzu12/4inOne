# Lumiknot (Docker): abgelaufene Daten und verwaiste Verbindungen löschen. Aktivieren: sudo systemctl enable --now 4inone-docker-cleanup.timer
[Unit]
Description=Lumiknot (Docker): abgelaufene Daten und verwaiste Verbindungen löschen

[Timer]
OnCalendar=*-*-* 03:15:00
Persistent=true
Unit=4inone-docker@cleanup.service

[Install]
WantedBy=timers.target
