# 4inOne (Docker): tägliches verschlüsseltes Backup. Aktivieren: sudo systemctl enable --now 4inone-docker-backup.timer
[Unit]
Description=4inOne (Docker): tägliches verschlüsseltes Backup

[Timer]
OnCalendar=*-*-* 02:45:00
Persistent=true
Unit=4inone-docker@backup.service

[Install]
WantedBy=timers.target
