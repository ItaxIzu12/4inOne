# Lumiknot Docker-Betrieb — Werte für Compose selbst. Kopieren nach /srv/4inone-data/docker.env, dann chmod 600.
# Die Django-Einstellungen stehen in einer eigenen Datei (ENV_FILE, Vorlage: .env.example im Repository).

# Wo alle Daten liegen: postgres/, private_media/, certs/, backups/
DATA_DIR=/srv/4inone-data
# Django-Einstellungen (wie backend/.env)
ENV_FILE=/srv/4inone-data/backend.env

# Datenbank. Passwort nur aus Buchstaben und Ziffern (es steht in einer URL), erzeugen z. B. mit
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=fourinone
POSTGRES_PASSWORD=
POSTGRES_DB=fourinone

# Adresse, unter der Lumiknot erreichbar ist (wie ALLOWED_HOSTS und FRONTEND_URL in der Django-Datei)
SERVER_NAME=4inone.example
# Eigene, schwer zu ratende Adresse des Django-Admins (ohne Schrägstriche). Gilt für nginx UND Django –
# in der Django-Datei nicht zusätzlich setzen.
ADMIN_URL_PATH=
# 0.0.0.0 = im Heimnetz erreichbar; 127.0.0.1 = nur auf dem Gerät (z. B. hinter Tailscale oder einem eigenen Proxy)
BIND_ADDRESS=0.0.0.0
# Ports auf dem Gerät (Standard 80/443)
HTTP_PORT=80
HTTPS_PORT=443
