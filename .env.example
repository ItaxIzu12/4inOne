# ============================================================
# .env.example — ins Repository committen (KEINE echten Werte hier)
# Workflow: diese Datei zu .env kopieren, dann jeden Wert aus dem
# Passwort-Manager (1Password/Bitwarden/etc.) eintragen. .env selbst
# ist in .gitignore erfasst und wird NIEMALS committet.
# (siehe ARCHITEKTUR.md §3.4 — Secrets nur über Umgebungsvariablen)
# ============================================================

# ============================================================
# DJANGO CORE — jetzt ausfüllen, auch für reine Solo-Entwicklung nötig
# ============================================================

# Erzeugen mit:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True nur lokal. In jeder Umgebung mit echtem Zugriff (auch Solo-Fernzugriff
# über VPN) auf False setzen.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Zufällig wirkender Pfad statt /admin/. Erzeugen mit:
# python -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_URL_PATH=admin-4in1-xyz

# ============================================================
# DATENBANK — PostgreSQL 16 in Docker (docs/LOKALE_DATENBANK.md)
# Einfachster Weg: ./scripts/dev-db.sh init füllt die vier Werte unten selbst aus
# (Zufallspasswort). Ohne DATABASE_URL fällt Django auf SQLite zurück — nur noch
# für Wegwerf-Testdatenbanken gedacht.
# ============================================================

# --- Für docker-compose.yml (Postgres-Container) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional, falls 5432 belegt ist (dann auch in DATABASE_URL ändern)
# POSTGRES_PORT=5433

# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Lokal: Host "localhost" (Django läuft auf dem Rechner, PostgreSQL im Container).
DATABASE_URL=

# ============================================================
# REDIS — für Token-Blacklist, Caching, Rate-Limiting (später)
# ============================================================

# "localhost" gilt nur, solange Django NICHT in Docker läuft.
# Sobald Django containerisiert wird: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================
# FRONTEND-VERBINDUNG — CORS (ARCHITEKTUR.md §3.1/§3.4: kein Wildcard)
# ============================================================

FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Origin der Capacitor-App (iOS/Android) — ohne diesen Eintrag schlagen
# API-Aufrufe aus der später gebauten nativen App fehl.
CAPACITOR_APP_ORIGIN=capacitor://localhost

# ============================================================
# E-MAIL-VERSAND — Passwort-Reset, Haushaltseinladungen, Erinnerungen
# Muss EU-basiert sein (DSGVO-Anspruch, GESAMTKONZEPT.md §7.4)
# ============================================================

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ============================================================
# RATE-LIMITS PRO SENSIBLEM ENDPUNKT (ARCHITEKTUR.md §3.9)
# Werte = Anfragen pro Minute, außer anders vermerkt. Nie leer/deaktiviert lassen.
# ============================================================

RATE_LIMIT_LOGIN=5
RATE_LIMIT_MFA_VERIFY=5
RATE_LIMIT_REGISTER=3
# Ausnahme von "pro Minute" oben: pro STUNDE, siehe settings.py-Kommentar
# bei DEFAULT_THROTTLE_RATES — ein Passwort-Reset ist kein Vorgang, den
# ein legitimer Nutzer mehrfach pro Minute auslöst.
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_HOUSEHOLD_INVITE=10
RATE_LIMIT_DATA_EXPORT=2
# Monats-/Jahresstand und Sparziel-Vorschau der privaten Finanzen pro Minute und Nutzer
RATE_LIMIT_FINANZEN_SUMMARY=120
# Öffentliche Website (backend/website/): Seitenzählung pro Minute und IP
RATE_LIMIT_PAGEVIEW=120

# Besucherzählung: Aufbewahrung der Tageszähler in Tagen — `python manage.py prune_website` täglich per Cron.
PAGEVIEW_RETENTION_DAYS=730

# Ablaufzeit für Haushaltseinladungs-Token in Tagen (ARCHITEKTUR.md §3.9)
HOUSEHOLD_INVITE_EXPIRY_DAYS=7

# ============================================================
# API-DOKUMENTATION / SWAGGER UI (ARCHITEKTUR.md §2.4)
# "true" nur lokal/Staging. In Produktion "false" oder zusätzlich absichern —
# niemals ungeschützt öffentlich, zeigt sonst die komplette API-Struktur offen.
# ============================================================

API_DOCS_ENABLED=true

# ============================================================
# FEHLER-MONITORING UND ADMIN-PANEL (docs/MONITORING.md)
# GlitchTip (Sentry-kompatibel) läuft getrennt: ./monitoring/glitchtip.sh init && up
# Leer = aus (keine Fehlerberichte, Admin-Panel zeigt „nicht verbunden“).
# ============================================================

# DSN des GlitchTip-Projekts (GlitchTip › Projekt › Einstellungen › Client Keys), z. B.
# http://<schlüssel>@localhost:8001/1
SENTRY_DSN=
# Umgebung in GlitchTip (Standard: entwicklung bei DEBUG=True, sonst produktion)
SENTRY_ENVIRONMENT=
# Für das Admin-Panel: Link „GlitchTip öffnen“ und – mit Token – die Liste der offenen Fehler.
# Token: GlitchTip › Profil › Auth Tokens, nur Leserechte (project:read, event:read, org:read).
GLITCHTIP_URL=http://localhost:8001
GLITCHTIP_ORG=
GLITCHTIP_API_TOKEN=
# Anmelde-Ereignisse im Admin-Panel: Aufbewahrung in Tagen (manage.py prune_auth_events täglich)
AUTH_EVENT_RETENTION_DAYS=90
# Fehlerberichte aus dem Browser über den Tunnel, pro IP und Minute
RATE_LIMIT_MONITORING_TUNNEL=60

# Ortsvorschläge beim Tippen (Termine, Reiseziel): Photon/OpenStreetMap über den Server. Leer = nur eigene Orte.
PLACES_PROVIDER_URL=https://photon.komoot.io/api/
RATE_LIMIT_PLACES=60

# Beta-Test (docs/beta/README.md): „Feedback geben“ im Kontomenü. Aus = unsichtbar, Senden 404.
BETA_FEEDBACK_ENABLED=False
BETA_FEEDBACK_RETENTION_DAYS=180
RATE_LIMIT_BETA_FEEDBACK=20
