# Kopieren nach .env und mit echten Werten befüllen. .env NIEMALS committen
# (siehe ARCHITEKTUR.md §3.4 — Secrets nur über Umgebungsvariablen/Secret-
# Manager, nie im Repository).

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Django (backend/.env, siehe backend/config/settings.py) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME — Host ist der
# docker-compose-Servicename "postgres", wenn Django ebenfalls in Docker läuft,
# sonst "localhost" bei einer lokal per `docker compose up` gestarteten DB.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=

# Angular-Dev-Server-Origin für CORS (ARCHITEKTUR.md §3.4: kein Wildcard)
FRONTEND_URL=http://localhost:4200

# Zufällig wirkender Pfad statt /admin/ (ARCHITEKTUR.md §3.4)
ADMIN_URL_PATH=
