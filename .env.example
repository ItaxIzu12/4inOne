# ============================================================
# .env.example — ins Repository committen (KEINE echten Werte hier)
# Workflow: diese Datei zu .env kopieren, dann jeden Wert aus dem
# Passwort-Manager (1Password/Bitwarden/etc.) eintragen. .env selbst
# ist in .gitignore erfasst und wird NIEMALS committet.
# (siehe ARCHITEKTUR.md §3.4 — Secrets nur über Umgebungsvariablen)
# ============================================================

# ============================================================
# DJANGO CORE — jetzt ausfüllen, auch für reine Solo-Entwicklung nötig
# ============================================================

# Erzeugen mit:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True nur lokal. In jeder Umgebung mit echtem Zugriff (auch Solo-Fernzugriff
# über VPN) auf False setzen.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Zufällig wirkender Pfad statt /admin/. Erzeugen mit:
# python -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_URL_PATH=admin-4in1-xyz

# ============================================================
# DATENBANK — SQLite jetzt (Solo-Entwicklung), PostgreSQL später
# (ARCHITEKTUR.md §2.2 und §0.2) — leer lassen, bis PostgreSQL gebraucht wird,
# Django fällt ohne DATABASE_URL automatisch auf SQLite zurück
# ============================================================

# --- Nur für docker-compose.yml (Postgres-Container) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Host = "postgres" (docker-compose-Servicename), wenn Django ebenfalls in
# Docker läuft, sonst "localhost" bei lokal per `docker compose up` gestarteter DB.
DATABASE_URL=

# ============================================================
# REDIS — für Token-Blacklist, Caching, Rate-Limiting (später)
# ============================================================

# "localhost" gilt nur, solange Django NICHT in Docker läuft.
# Sobald Django containerisiert wird: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================
# FRONTEND-VERBINDUNG — CORS (ARCHITEKTUR.md §3.1/§3.4: kein Wildcard)
# ============================================================

FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Origin der Capacitor-App (iOS/Android) — ohne diesen Eintrag schlagen
# API-Aufrufe aus der später gebauten nativen App fehl.
CAPACITOR_APP_ORIGIN=capacitor://localhost

# ============================================================
# E-MAIL-VERSAND — Passwort-Reset, Haushaltseinladungen, Erinnerungen
# Muss EU-basiert sein (DSGVO-Anspruch, GESAMTKONZEPT.md §7.4)
# ============================================================

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ============================================================
# RATE-LIMITS PRO SENSIBLEM ENDPUNKT (ARCHITEKTUR.md §3.9)
# Werte = Anfragen pro Minute, außer anders vermerkt. Nie leer/deaktiviert lassen.
# ============================================================

RATE_LIMIT_LOGIN=5
RATE_LIMIT_MFA_VERIFY=5
RATE_LIMIT_REGISTER=3
# Ausnahme von "pro Minute" oben: pro STUNDE, siehe settings.py-Kommentar
# bei DEFAULT_THROTTLE_RATES — ein Passwort-Reset ist kein Vorgang, den
# ein legitimer Nutzer mehrfach pro Minute auslöst.
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_HOUSEHOLD_INVITE=10
RATE_LIMIT_DATA_EXPORT=2

# Ablaufzeit für Haushaltseinladungs-Token in Tagen (ARCHITEKTUR.md §3.9)
HOUSEHOLD_INVITE_EXPIRY_DAYS=7

# ============================================================
# API-DOKUMENTATION / SWAGGER UI (ARCHITEKTUR.md §2.4)
# "true" nur lokal/Staging. In Produktion "false" oder zusätzlich absichern —
# niemals ungeschützt öffentlich, zeigt sonst die komplette API-Struktur offen.
# ============================================================

API_DOCS_ENABLED=true

# ============================================================
# FEHLER-TRACKING (ARCHITEKTUR.md §3.7)
# ============================================================

SENTRY_DSN=
